# vim: ft=toml

{{ if not .ephemeral }}

{{- if eq .chezmoi.os "linux" }}

[".local/bin/age"]
    type = "archive-file"
    url = {{ gitHubLatestReleaseAssetURL "FiloSottile/age" (printf "age-*-%s-%s.tar.gz" .chezmoi.os .chezmoi.arch) | quote }}
    executable = true
    path = "age/age"

[".local/bin/age-keygen"]
    type = "archive-file"
    url = {{ gitHubLatestReleaseAssetURL "FiloSottile/age" (printf "age-*-%s-%s.tar.gz" .chezmoi.os .chezmoi.arch) | quote }}
    executable = true
    path = "age/age-keygen"

[".local/bin/gh"]
    type = "archive-file"
    url = {{ gitHubLatestReleaseAssetURL "cli/cli" (printf "gh_*_%s_%s.tar.gz" .chezmoi.os .chezmoi.arch) | quote }}
    executable = true
    stripComponents = 1
    path = "bin/gh"

[".local/bin/win32yank.exe"]
    type = "archive-file"
    url = {{ gitHubLatestReleaseAssetURL "equalsraf/win32yank" "win32yank-x64.zip" | quote }}
    executable = true
    stripComponents = 0
    path = "win32yank.exe"

{{ end }}

{{ end }}
