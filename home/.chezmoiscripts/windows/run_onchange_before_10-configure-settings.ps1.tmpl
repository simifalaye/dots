# vim: ft=ps1

{{ if (and (not .ephemeral) (not .headless)) -}}

$ErrorActionPreference = 'Stop'

$lib = Join-Path '{{ .chezmoi.workingTree }}' 'home\helpers\windows\lib.ps1'
. $lib

if (-not $gsudo) {
    throw "Cannot get admin privileges which are required to run this script"
}

if (-not $isAdmin) {
    Write-Info "Elevating via gsudo..."

    & $gsudo.FullName powershell.exe `
        -NoProfile `
        -ExecutionPolicy Bypass `
        -File $PSCommandPath

    exit $LASTEXITCODE
}

$Settings = @(
    #
    # General — Privacy and Suggestions
    #

    # Disables the advertising ID for cross-app advertising experiences for the current user.
    @{ Path = 'HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\AdvertisingInfo'; Name = 'Enabled'; Type = 'DWord'; Value = 0 }

    # Removes the existing advertising ID for the current user, if present.
    @{ Path = 'HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\AdvertisingInfo'; Name = 'Id'; Absent = $true }

    # Disables tracking of applications launched by the user for Start menu personalization.
    @{ Path = 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced'; Name = 'Start-TrackProgs'; Type = 'DWord'; Value = 0 }

    # Disables SmartScreen web content evaluation for Microsoft Store apps.
    @{ Path = 'HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\AppHost'; Name = 'EnableWebContentEvaluation'; Type = 'DWord'; Value = 0 }

    # Disables the Windows input telemetry collection setting associated with TIPC.
    @{ Path = 'HKCU:\SOFTWARE\Microsoft\Input\TIPC'; Name = 'Enabled'; Type = 'DWord'; Value = 0 }

    # Disables suggested content in Settings (content subscription ID 338393).
    @{ Path = 'HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\ContentDeliveryManager'; Name = 'SubscribedContent-338393Enabled'; Type = 'DWord'; Value = 0 }

    # Disables suggested content in Settings (content subscription ID 338394).
    @{ Path = 'HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\ContentDeliveryManager'; Name = 'SubscribedContent-338394Enabled'; Type = 'DWord'; Value = 0 }

    # Disables suggested content in Settings (content subscription ID 338396).
    @{ Path = 'HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\ContentDeliveryManager'; Name = 'SubscribedContent-338396Enabled'; Type = 'DWord'; Value = 0 }

    # Disables welcome and What's New tips and suggestions.
    @{ Path = 'HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\ContentDeliveryManager'; Name = 'SubscribedContent-310093Enabled'; Type = 'DWord'; Value = 0 }

    # Disables tips and suggestions shown while using Windows.
    @{ Path = 'HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\ContentDeliveryManager'; Name = 'SubscribedContent-338389Enabled'; Type = 'DWord'; Value = 0 }


    #
    # Speech, Inking, and Typing
    #

    # Restricts implicit collection of typed text for personalization.
    @{ Path = 'HKCU:\SOFTWARE\Microsoft\InputPersonalization'; Name = 'RestrictImplicitTextCollection'; Type = 'DWord'; Value = 1 }

    # Restricts implicit collection of handwriting and ink input for personalization.
    @{ Path = 'HKCU:\SOFTWARE\Microsoft\InputPersonalization'; Name = 'RestrictImplicitInkCollection'; Type = 'DWord'; Value = 1 }

    # Disables harvesting contacts for input personalization.
    @{ Path = 'HKCU:\SOFTWARE\Microsoft\InputPersonalization\TrainedDataStore'; Name = 'HarvestContacts'; Type = 'DWord'; Value = 0 }

    # Sets the accepted privacy policy flag to 0 for Windows personalization settings.
    @{ Path = 'HKCU:\SOFTWARE\Microsoft\Personalization\Settings'; Name = 'AcceptedPrivacyPolicy'; Type = 'DWord'; Value = 0 }

    # Sets the online speech privacy consent flag to 0.
    @{ Path = 'HKCU:\SOFTWARE\Microsoft\Speech_OneCore\Settings\OnlineSpeechPrivacy'; Name = 'HasAccepted'; Type = 'DWord'; Value = 0 }

    #
    # Feedback and Diagnostic Data
    #

    # Sets the number of feedback requests allowed per period to zero.
    @{ Path = 'HKCU:\SOFTWARE\Microsoft\Siuf\Rules'; Name = 'NumberOfSIUFInPeriod'; Type = 'DWord'; Value = 0 }

    # Sets the system telemetry policy to level 1 (Basic on Windows versions that support this legacy level).
    @{ Path = 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\DataCollection'; Name = 'AllowTelemetry'; Type = 'DWord'; Value = 1 }

    # Sets the maximum permitted telemetry level to 1 where this policy is supported.
    @{ Path = 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\DataCollection'; Name = 'MaxTelemetryAllowed'; Type = 'DWord'; Value = 1 }

    #
    # File Explorer
    #

    # Shows hidden files in File Explorer.
    @{ Path = 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced'; Name = 'Hidden'; Type = 'DWord'; Value = 1 }

    # Shows file extensions for known file types.
    @{ Path = 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced'; Name = 'HideFileExt'; Type = 'DWord'; Value = 0 }

    # Shows the full folder path in File Explorer's title bar where supported.
    @{ Path = 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\CabinetState'; Name = 'FullPath'; Type = 'DWord'; Value = 1 }

    # Disables thumbnail caching in Thumbs.db files on network folders.
    @{ Path = 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Policies\Explorer'; Name = 'DisableThumbnailsOnNetworkFolders'; Type = 'DWord'; Value = 1 }

    #
    # Taskbar
    #

    # Hides the Search button or search box on the taskbar.
    @{ Path = 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Search'; Name = 'SearchboxTaskbarMode'; Type = 'DWord'; Value = 0 }

    # Hides the Task View button on the taskbar.
    @{ Path = 'HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\Advanced'; Name = 'ShowTaskViewButton'; Type = 'DWord'; Value = 0 }

    # Hides the Chat button on the taskbar on Windows versions that support this setting.
    @{ Path = 'HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\Advanced'; Name = 'TaskbarMn'; Type = 'DWord'; Value = 0 }

    # Disables accent colors on the taskbar, Start menu, and supported system tray surfaces.
    @{ Path = 'HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\Themes\Personalize'; Name = 'ColorPrevalence'; Type = 'DWord'; Value = 0 }

    # 0 = Left, 1 = Center
    @{ Path = 'HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\Advanced'; Name = 'TaskbarAl'; Type = 'DWord'; Value = 0 },

    # 1 = Auto-hide
    @{ Path = 'HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\Advanced'; Name = 'TaskbarAutohide'; Type = 'DWord'; Value = 1 },

    # 1 = Show badges
    @{ Path = 'HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\Advanced'; Name = 'TaskbarBadges'; Type = 'DWord'; Value = 1 },

    # 0 = Always combine, 1 = When taskbar is full, 2 = Never
    @{ Path = 'HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\Advanced'; Name = 'TaskbarGlomLevel'; Type = 'DWord'; Value = 1 },

    # 1 = Smaller buttons
    @{ Path = 'HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\Advanced'; Name = 'TaskbarSmallIcons'; Type = 'DWord'; Value = 1 },

    #
    # Window Appearance
    #

    # Disables accent colors on window title bars and borders.
    @{ Path = 'HKCU:\SOFTWARE\Microsoft\Windows\DWM'; Name = 'ColorPrevalence'; Type = 'DWord'; Value = 0 }

    #
    # Recycle Bin
    #

    # Disables the confirmation dialog displayed when deleting files to the Recycle Bin.
    @{ Path = 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Policies\Explorer'; Name = 'ConfirmFileDelete'; Type = 'DWord'; Value = 0 }

    #
    # Accessibility — Narrator
    #

    # Disables launching Narrator using the Windows key + Enter keyboard shortcut.
    @{ Path = 'HKCU:\SOFTWARE\Microsoft\Narrator\NoRoam'; Name = 'WinEnterLaunchEnabled'; Type = 'DWord'; Value = 0 }

    #
    # Window Management — Snap
    #

    # Disables automatic window arrangement when windows are dragged to screen edges.
    @{ Path = 'HKCU:\Control Panel\Desktop'; Name = 'WindowArrangementActive'; Type = 'String'; Value = '0' }

    # Disables automatically resizing windows to fill available space when using Snap.
    @{ Path = 'HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\Advanced'; Name = 'SnapFill'; Type = 'DWord'; Value = 0 }

    # Disables Snap Assist suggestions for other windows to place alongside a snapped window.
    @{ Path = 'HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\Advanced'; Name = 'SnapAssist'; Type = 'DWord'; Value = 0 }

    # Disables automatic resizing of adjacent windows when snapping windows.
    @{ Path = 'HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\Advanced'; Name = 'JointResize'; Type = 'DWord'; Value = 0 }

    #
    # Typing — Autocorrection
    #

    # Disables automatic text correction in the Windows touch keyboard / text input experience where supported.
    @{ Path = 'HKCU:\SOFTWARE\Microsoft\TabletTip\1.7'; Name = 'EnableAutocorrection'; Type = 'DWord'; Value = 0 }

    #
    # Startup and Boot
    #

    # Disables the Windows startup sound through the system policy settings.
    @{ Path = 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System'; Name = 'DisableStartupSound'; Type = 'DWord'; Value = 1 }

    # Disables the Windows startup sound through the LogonUI boot animation settings.
    @{ Path = 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Authentication\LogonUI\BootAnimation'; Name = 'DisableStartupSound'; Type = 'DWord'; Value = 1 }

    # Disables the Windows startup sound through the Windows edition override setting, where supported.
    @{ Path = 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\EditionOverrides'; Name = 'UserSetting_DisableStartupSound'; Type = 'DWord'; Value = 1 }

    #
    # Animations
    #

    # Disable some animations
    @{ Path = 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\VisualEffects'; Name = 'VisualFXSetting'; Type = 'DWord'; Value = 2; Relogin = $true }
    @{ Path = 'HKCU:\Control Panel\Desktop\WindowMetrics'; Name = 'MinAnimate'; Type = 'String'; Value = '0'; Relogin = $true }
)

Write-Info "Configuring registry settings..."

$restartRequired = $false
$reloginRequired = $false

foreach ($Setting in $Settings) {
    $path = $Setting.Path
    $name = $Setting.Name

    if ($Setting.Absent) {
        if (Test-Path -LiteralPath $path) {
            $key = Get-Item -LiteralPath $path

            if ($key.GetValueNames() -contains $name) {
                Write-Info "Removing $path\$name"
                Remove-ItemProperty -LiteralPath $path -Name $name
            }
        }

        continue
    }

    $type = $Setting.Type
    $value = $Setting.Value

    # Create the registry key if it doesn't exist.
    if (-not (Test-Path -LiteralPath $path)) {
        New-Item -Path $path -Force | Out-Null
    }

    $key = Get-Item -LiteralPath $path
    $exists = $key.GetValueNames() -contains $name

    # Check both the registry type and value.
    $needsUpdate = (
        -not $exists -or
        $key.GetValueKind($name).ToString() -ne $type -or
        $key.GetValue($name) -cne $value
    )

    if ($needsUpdate) {
        Write-Info "Setting $path\$name = $value"

        New-ItemProperty `
            -LiteralPath $path `
            -Name $name `
            -PropertyType $type `
            -Value $value `
            -Force | Out-Null

        if ($Setting.Restart) {
          $restartRequired = $true
        }
        if ($Setting.Relogin) {
          $reloginRequired = $true
        }
    }
}

if ($restartRequired) {
  Write-Warn "A restart will be required before changes take effect"
} elseif ($reloginRequired) {
  Write-Warn "A re-login will be required before changes take effect"
}

Write-Warn "Remember to disable animations in Settings > Accessibility > Visual effects > Animation effects"

{{ end -}}
