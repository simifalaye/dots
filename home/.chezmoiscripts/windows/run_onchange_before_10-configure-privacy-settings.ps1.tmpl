# vim: ft=ps1

{{ if (and (not .ephemeral) (not .headless)) -}}

$ErrorActionPreference = 'Stop'

$Settings = @(
    # Advertising
    @{ Path = 'HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\AdvertisingInfo'; Name = 'Enabled'; Type = 'DWord'; Value = 0 }
    @{ Path = 'HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\AdvertisingInfo'; Name = 'Id'; Absent = $true }

    # Start menu / content suggestions
    @{ Path = 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced'; Name = 'Start-TrackProgs'; Type = 'DWord'; Value = 0 }
    @{ Path = 'HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\AppHost'; Name = 'EnableWebContentEvaluation'; Type = 'DWord'; Value = 0 }

    # Input / personalization
    @{ Path = 'HKCU:\SOFTWARE\Microsoft\Input\TIPC'; Name = 'Enabled'; Type = 'DWord'; Value = 0 }
    @{ Path = 'HKCU:\Control Panel\International\User Profile'; Name = 'HttpAcceptLanguageOptOut'; Type = 'DWord'; Value = 1 }
    @{ Path = 'HKCU:\SOFTWARE\Microsoft\InputPersonalization'; Name = 'RestrictImplicitTextCollection'; Type = 'DWord'; Value = 1 }
    @{ Path = 'HKCU:\SOFTWARE\Microsoft\InputPersonalization'; Name = 'RestrictImplicitInkCollection'; Type = 'DWord'; Value = 1 }
    @{ Path = 'HKCU:\SOFTWARE\Microsoft\InputPersonalization\TrainedDataStore'; Name = 'HarvestContacts'; Type = 'DWord'; Value = 0 }

    # Content delivery / suggestions
    @{ Path = 'HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\ContentDeliveryManager'; Name = 'SubscribedContent-338393Enabled'; Type = 'DWord'; Value = 0 }
    @{ Path = 'HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\ContentDeliveryManager'; Name = 'SubscribedContent-338394Enabled'; Type = 'DWord'; Value = 0 }
    @{ Path = 'HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\ContentDeliveryManager'; Name = 'SubscribedContent-338396Enabled'; Type = 'DWord'; Value = 0 }
    @{ Path = 'HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\ContentDeliveryManager'; Name = 'SubscribedContent-310093Enabled'; Type = 'DWord'; Value = 0 }
    @{ Path = 'HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\ContentDeliveryManager'; Name = 'SubscribedContent-338389Enabled'; Type = 'DWord'; Value = 0 }

    # Privacy / personalization
    @{ Path = 'HKCU:\SOFTWARE\Microsoft\Personalization\Settings'; Name = 'AcceptedPrivacyPolicy'; Type = 'DWord'; Value = 0 }
    @{ Path = 'HKCU:\SOFTWARE\Microsoft\Speech_OneCore\Settings\OnlineSpeechPrivacy'; Name = 'HasAccepted'; Type = 'DWord'; Value = 0 }
    @{ Path = 'HKCU:\SOFTWARE\Microsoft\Siuf\Rules'; Name = 'NumberOfSIUFInPeriod'; Type = 'DWord'; Value = 0 }
)

Write-Host "Configuring privacy settings..."

foreach ($Setting in $Settings) {
    $path = $Setting.Path
    $name = $Setting.Name

    if ($Setting.Absent) {
        if (Test-Path -LiteralPath $path) {
            $key = Get-Item -LiteralPath $path

            if ($key.GetValueNames() -contains $name) {
                Write-Host "Removing $path\$name"
                Remove-ItemProperty -LiteralPath $path -Name $name
            }
        }

        continue
    }

    if (-not (Test-Path -LiteralPath $path)) {
        New-Item -Path $path -Force | Out-Null
    }

    $key = Get-Item -LiteralPath $path
    $exists = $key.GetValueNames() -contains $name

    $needsUpdate = (
        -not $exists -or
        $key.GetValueKind($name).ToString() -ne $Setting.Type -or
        $key.GetValue($name) -cne $Setting.Value
    )

    if ($needsUpdate) {
        Write-Host "Setting $path\$name = $($Setting.Value)"

        New-ItemProperty `
            -LiteralPath $path `
            -Name $name `
            -PropertyType $Setting.Type `
            -Value $Setting.Value `
            -Force | Out-Null
    }
}

{{ end -}}
