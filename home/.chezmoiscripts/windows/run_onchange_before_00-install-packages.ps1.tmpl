# vim: ft=ps1

{{ if (and (not .ephemeral) (not .headless)) -}}

$ErrorActionPreference = 'Stop'

$lib = Join-Path '{{ .chezmoi.workingTree }}' 'home\helpers\windows\lib.ps1'
. $lib

{{ $packages := list
    "7zip.7zip"
    "Chocolatey.Chocolatey"
    "gerardog.gsudo"
    "Git.Git"
    "GitHub.cli"
    "Microsoft.Sysinternals.Ctrl2Cap"
    "Alacritty.Alacritty"
    "glzr-io.glazewm"
    "jqlang.jq"
    "LibreWolf.LibreWolf"
    "Microsoft.WindowsTerminal" -}}

Write-Info "Installing packages..."

WingetInstall -AppIds @(
{{ range $packages -}}
    "{{ . }}"
{{ end -}}
)

{{ $upackages := list
    "equalsraf.win32yank"
    "wez.wezterm"
    "Microsoft.PowerToys"
    "Neovide.Neovide"
    "Dropbox.Dropbox"
    "Flow-Launcher.Flow.Launcher" -}}

Write-Info "Unstalling unneeded packages..."

WingetUninstall -AppIds @(
{{ range $upackages -}}
    "{{ . }}"
{{ end -}}
)

{{ end -}}
