# vim: ft=ps1

{{ if (and (not .ephemeral) (not .headless)) -}}

$ErrorActionPreference = 'Stop'

$lib = Join-Path '{{ .chezmoi.workingTree }}' 'home\helpers\windows\lib.ps1'
. $lib

if (-not $isAdmin) {
    Write-Info "Elevating via sudo..."

    sudo powershell.exe `
        -NoProfile `
        -ExecutionPolicy Bypass `
        -File $PSCommandPath

    exit $LASTEXITCODE
}

$choco = GetExePath `
    -Directories @(
        (Join-Path $env:ProgramData 'chocolatey')
    ) `
    -ExeName @('choco.exe')
if (-not $choco) {
    throw 'Could not find choco.exe.'
}

function ChocoInstall {
    param (
        [Parameter(Mandatory = $true)]
        [string[]]$PackageNames
    )

    foreach ($PackageName in $PackageNames) {
        $isInstalled = & $choco.FullName list --local-only --limit-output 2>$null |
            Select-String -SimpleMatch $PackageName
        if (-not $isInstalled) {
            Write-Host "Installing Chocolatey package: $PackageName..."
            & $choco.FullName install $PackageName --yes --no-progress --limit-output
        }
    }
}

{{ $packages := list
    "keypirinha" -}}

Write-Info "Installing choco packages..."

ChocoInstall -PackageNames @(
{{ range $packages -}}
    "{{ . }}"
{{ end -}}
)

{{ end -}}
