# vim: ft=ps1

$ErrorActionPreference = 'Stop'

$lib = Join-Path '{{ .chezmoi.workingTree }}' 'home\helpers\windows\lib.ps1'
. $lib

$sshEmail = "{{ .email }}"
$sshKeyPath = "$HOME\.ssh\id_ed25519"
$dotfilesDir = "{{ .chezmoi.workingTree }}"

Write-Info "Checking SSH key setup..."

# Generate SSH Key if missing
if (-not (Test-Path $sshKeyPath)) {
    Write-Info "No SSH key found. Generating ed25519 key..."
    New-Item -ItemType Directory -Path "$HOME\.ssh" -Force | Out-Null
    ssh-keygen -t ed25519 -C $sshEmail -f $sshKeyPath -N '""'
}

# Check if gh CLI is authenticated; if not, prompt interactive login & add SSH key
if (Get-Command gh -ErrorAction SilentlyContinue) {
    $ghAuthStatus = gh auth status 2>&1
    if ($LASTEXITCODE -ne 0) {
        Write-Info "Authenticating with GitHub CLI to register SSH key..."
        # Interactively authenticates and uploads the public key to your GitHub account
        gh auth login --web -h github.com -p ssh -w
        gh ssh-key add "${sshKeyPath}.pub" --title "Windows-$(hostname)"
    }
}

# Swap chezmoi source repository origin from HTTPS to SSH
if (Test-Path "$dotfilesDir\.git") {
    $currentRemote = git -C "$dotfilesDir" remote get-url origin
    if ($currentRemote -like "https://github.com/*") {
        $sshRemote = $currentRemote -replace "https://github.com/", "git@github.com:"
        Write-Info "Converting chezmoi Git origin to SSH: $sshRemote"
        git -C "$dotfilesDir" remote set-url origin $sshRemote
    }
}
